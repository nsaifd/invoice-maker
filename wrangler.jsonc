{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invoice-maker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve index.html for client-side routes like /invoices/1 so page refreshes work.
    "not_found_handling": "single-page-application",
    // The Worker sees every request: it serves the landing page on home.involet.saifux.co,
    // redirects logged-out visitors from the app's home page, and handles the API.
    "run_worker_first": true
  },
  // Both hostnames are listed so a deploy keeps them (Wrangler replaces domains not listed here).
  "routes": [
    { "pattern": "involet.saifux.co", "custom_domain": true },
    { "pattern": "home.involet.saifux.co", "custom_domain": true }
  ],
  // The marketing site is its own Worker; it's served on home.involet.saifux.co through this one.
  "services": [{ "binding": "LANDING", "service": "black-sunset-577c" }],
  "vars": {
    // Where visitors without an account land.
    "LANDING_URL": "https://home.involet.saifux.co"
  },
  // No database_id: Wrangler creates the D1 database automatically on first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "invoice-maker-db" }]
}
