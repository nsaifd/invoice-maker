{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invoice-maker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve index.html for client-side routes like /invoices/1 so page refreshes work.
    "not_found_handling": "single-page-application",
    // Only the share-link API needs the Worker; everything else is static.
    "run_worker_first": ["/api/*"]
  },
  // No database_id: Wrangler creates the D1 database automatically on first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "invoice-maker-db" }]
}
