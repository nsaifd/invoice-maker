{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invoice-maker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve index.html for client-side routes like /invoices/1 so page refreshes work.
    "not_found_handling": "single-page-application",
    // The API needs the Worker, and so does the home page (landing-page redirect); the rest is static.
    "run_worker_first": ["/api/*", "/"]
  },
  "vars": {
    // Where visitors without an account land. Switch to https://home.involet.saifux.co once that
    // custom domain is attached to the landing-page Worker.
    "LANDING_URL": "https://black-sunset-577c.connect-saifd.workers.dev"
  },
  // No database_id: Wrangler creates the D1 database automatically on first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "invoice-maker-db" }]
}
